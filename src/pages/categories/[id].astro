---
import { render } from 'astro:content';
import Base from '@/layouts/Base.astro';
import ComparisonTable from '@/components/ComparisonTable.astro';
import CategoryBadge from '@/components/CategoryBadge.astro';
import { LABELS, LAYER_ORDER } from '@/config';
import { byId, connectedFrom, getAll, toolsInCategory, type Category, type Tool } from '@/lib/content';

const sortByLayer = (ts: Tool[]) =>
  [...ts].sort((a, b) => LAYER_ORDER.indexOf(a.data.layer) - LAYER_ORDER.indexOf(b.data.layer));

export async function getStaticPaths() {
  const { categories } = await getAll();
  return categories.map((c) => ({ params: { id: c.id }, props: { category: c } }));
}
interface Props {
  category: Category;
}
const { category } = Astro.props;
const { tools, capabilities, categories } = await getAll();
const list = toolsInCategory(tools, category.id);
const { Content } = await render(category);
const hasBody = category.body && category.body.trim().length > 0;

const toolsById = byId(tools);
const catsById = byId(categories);
const start = toolsById.get(category.data.startWith.id);
const incoming = connectedFrom(categories, category.id);
const prev = categories.find((c) => c.data.order === category.data.order - 1);
const next = categories.find((c) => c.data.order === category.data.order + 1);

// この分類のツールが持つ能力（横断リンク）
const capsById = byId(capabilities);
const capCount = new Map<string, number>();
for (const t of list) for (const c of t.data.can) capCount.set(c.id, (capCount.get(c.id) ?? 0) + 1);
const caps = [...capCount.entries()]
  .sort((a, b) => b[1] - a[1])
  .map(([id, n]) => ({ cap: capsById.get(id)!, n }))
  .filter((x) => x.cap);
---

<Base title={category.data.name} description={category.data.plain}>
  <article class="stack" style="--flow: 1.5rem">
    <header class="stack" style="--flow: 0.5rem">
      <div class="meta">
        <CategoryBadge id={category.id} name={`分野 ${String(category.data.order).padStart(2, '0')}`} bar link={false} />
        <a href="/map/">全体像に戻る</a>
      </div>
      <h1>{category.data.name}</h1>
      <p class="lede" style="font-size: var(--fs-l)">{category.data.plain}</p>
      <p class="prose">{category.data.role}。</p>
    </header>

    <section class="section mt-0 start" aria-labelledby="start-h">
      <h2 id="start-h">最初に触るなら</h2>
      {
        start && (
          <p class="prose">
            <a href={`/tools/${start.id}/`}>
              <strong>{start.data.name}</strong>
            </a>
            <span class="muted">：{start.data.oneLiner}</span>
            <br />
            {category.data.startWhy}
          </p>
        )
      }
    </section>

    <section class="section" aria-labelledby="conn-h">
      <h2 id="conn-h">隣の分野とのつながり</h2>
      <div class="table-wrap">
        <table class="table">
          <thead>
            <tr>
              <th scope="col">分野</th>
              <th scope="col">どうつながるか</th>
            </tr>
          </thead>
          <tbody>
            {
              category.data.connections.map((x) => {
                const to = catsById.get(x.to.id);
                return (
                  <tr>
                    <th scope="row" class="nowrap">
                      {to && <CategoryBadge id={to.id} name={to.data.name} />}
                    </th>
                    <td>{x.how}</td>
                  </tr>
                );
              })
            }
            {
              incoming.map(({ category: from, how }) => (
                <tr>
                  <th scope="row" class="nowrap">
                    <CategoryBadge id={from.id} name={from.data.name} />
                    <span class="muted">（から見ると）</span>
                  </th>
                  <td>{how}</td>
                </tr>
              ))
            }
          </tbody>
        </table>
      </div>
    </section>

    {
      hasBody && (
        <section class="section prose" aria-labelledby="body-h">
          <h2 id="body-h">この分野を理解する</h2>
          <div class="stack" style="--flow: 0.75rem">
            <Content />
          </div>
        </section>
      )
    }

    <section class="section" aria-labelledby="cmp-h">
      <h2 id="cmp-h">この分野のツール（{list.length}件）</h2>
      <p class="muted" style="font-size: var(--fs-s)">
        種別（自分で書く土台か、借りて使うサービスか）で分けている。「主要制約」は各ツールで最も先に当たる限界。
      </p>
      {
        list.length > 0 ? (
          <ComparisonTable tools={list} caption={`${category.data.name} の比較`} groupByLayer />
        ) : (
          <p class="muted">この分野にはまだツールが掲載されていません。</p>
        )
      }
    </section>

    {
      list.length > 0 && (
        <section class="section" aria-labelledby="v-h">
          <h2 id="v-h">どれを選ぶか</h2>
          <div class="table-wrap">
            <table class="table">
              <thead>
                <tr>
                  <th scope="col">ツール</th>
                  <th scope="col">種別</th>
                  <th scope="col">どういう時に選ぶか／避けるか</th>
                </tr>
              </thead>
              <tbody>
                {sortByLayer(list).map((t) => (
                  <tr>
                    <th scope="row" class="nowrap">
                      <a href={`/tools/${t.id}/`}>{t.data.name}</a>
                    </th>
                    <td class="nowrap">{LABELS.layer[t.data.layer]}</td>
                    <td>{t.data.verdict}</td>
                  </tr>
                ))}
              </tbody>
            </table>
          </div>
        </section>
      )
    }

    {
      caps.length > 0 && (
        <section class="section" aria-labelledby="caps-h">
          <h2 id="caps-h">この分野が担う目的</h2>
          <p class="muted" style="font-size: var(--fs-s)">
            目的ごとのページでは、他の分野のツールも含めて横断比較できる。
          </p>
          <ul>
            {caps.map(({ cap, n }) => (
              <li>
                <a href={`/capabilities/${cap.id}/`}>{cap.data.name}</a>
                <span class="muted">（この分野から {n}件）</span>
              </li>
            ))}
          </ul>
        </section>
      )
    }

    <footer class="section meta">
      {prev && <a href={`/categories/${prev.id}/`}>前：{prev.data.name}</a>}
      {next && <a href={`/categories/${next.id}/`}>次：{next.data.name}</a>}
      <a href="/categories/">分野の一覧</a>
    </footer>
  </article>
</Base>

<style>
  .start {
    border-left: 4px solid var(--ink);
    padding-inline-start: 1rem;
  }
  .start h2 {
    border: 0;
    margin: 0 0 0.25rem;
    padding: 0;
  }
</style>
