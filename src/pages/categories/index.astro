---
import Base from '@/layouts/Base.astro';
import CategoryBadge from '@/components/CategoryBadge.astro';
import { getAll, toolsInCategory } from '@/lib/content';

const { tools, categories } = await getAll();
---

<Base title="分野から探す" description="12の分類と、それぞれが答える問い。">
  <div class="stack">
    <h1>分野から探す</h1>
    <p class="lede prose">
      各分類は「何を決めるための分類か」を問いの形で持つ。問いに当てはまる分類を開くと、その中のツールを同じ列で比較できる。
    </p>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">分類</th>
            <th scope="col">答える問い</th>
            <th scope="col">掲載</th>
          </tr>
        </thead>
        <tbody>
          {
            categories.map((c) => {
              const ts = toolsInCategory(tools, c.id);
              return (
                <tr>
                  <th scope="row" class="nowrap">
                    <CategoryBadge id={c.id} name={c.data.name} bar />
                  </th>
                  <td>
                    {c.data.question}
                    <div class="muted">{c.data.summary}</div>
                  </td>
                  <td class="nowrap">
                    {ts.length}件
                    <div class="muted" style="white-space: normal">
                      {ts.map((t, i) => (
                        <>
                          {i > 0 && '、'}
                          <a href={`/tools/${t.id}/`}>{t.data.name}</a>
                        </>
                      ))}
                    </div>
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </div>
</Base>
