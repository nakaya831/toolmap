---
import Base from '@/layouts/Base.astro';
import CategoryBadge from '@/components/CategoryBadge.astro';
import StackMap from '@/components/StackMap.astro';
import { byId, getAll, toolsInCategory } from '@/lib/content';

const { tools, categories } = await getAll();
const toolsById = byId(tools);
---

<Base title="分野から学ぶ" description="ソフトウェアを構成する12の分野。それぞれ何をする分野で、どうつながり、最初に何を触ればよいか。">
  <div class="stack" style="--flow: 1.5rem">
    <header class="stack" style="--flow: 0.5rem">
      <h1>分野から学ぶ：部品の「役割」で分ける</h1>
      <p class="lede prose">
        ソフトウェアを構成する12の分野。「何のための部品か」で分けている。上から順に学ぶことを想定した並びで、分野同士のつながりは<a href="/map/">全体像</a>に図と文章で解説している。
      </p>
    </header>
    <StackMap categories={categories} compact />
    <p class="muted" style="font-size: var(--fs-s)"><a href="/map/">図の読み方・学ぶ順番・つながりの一覧へ</a></p>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">順</th>
            <th scope="col">分野</th>
            <th scope="col">何をする分野か</th>
            <th scope="col">最初に触るなら</th>
            <th scope="col">掲載ツール</th>
          </tr>
        </thead>
        <tbody>
          {
            categories.map((c) => {
              const ts = toolsInCategory(tools, c.id);
              const start = toolsById.get(c.data.startWith.id);
              return (
                <tr>
                  <td class="mono nowrap">{String(c.data.order).padStart(2, '0')}</td>
                  <th scope="row" class="nowrap">
                    <CategoryBadge id={c.id} name={c.data.name} bar />
                  </th>
                  <td>
                    {c.data.plain}
                    <div class="muted">{c.data.role}</div>
                  </td>
                  <td class="nowrap">{start && <a href={`/tools/${start.id}/`}>{start.data.name}</a>}</td>
                  <td>
                    {ts.map((t, i) => (
                      <>
                        {i > 0 && '、'}
                        <a href={`/tools/${t.id}/`}>{t.data.name}</a>
                      </>
                    ))}
                  </td>
                </tr>
              );
            })
          }
        </tbody>
      </table>
    </div>
  </div>
</Base>
