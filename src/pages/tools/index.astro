---
import Base from '@/layouts/Base.astro';
import CategoryBadge from '@/components/CategoryBadge.astro';
import { LABELS, LAYER_DESCRIPTIONS, LAYER_ORDER } from '@/config';
import { getAll, sortToolsForLearning, toolsInCategory } from '@/lib/content';

const { tools, categories } = await getAll();
---

<Base title="ツール一覧" description={`掲載ツール ${tools.length} 件の全量一覧。分野別、学習コスト順。`}>
  <div class="stack" style="--flow: 1.5rem">
    <header class="stack" style="--flow: 0.5rem">
      <h1>ツール一覧（{tools.length}件）</h1>
      <p class="lede prose">
        掲載しているすべてのツールを、分野ごとに学習コストの低い順で並べた。略称や別名で探すなら <a href="/search/">検索</a>。
      </p>
      <nav aria-label="分野へ移動" class="meta">
        {categories.map((c) => <a href={`#c-${c.id}`}>{c.data.name}</a>)}
      </nav>
    </header>

    {
      categories.map((c) => {
        const list = sortToolsForLearning(toolsInCategory(tools, c.id));
        return (
          <section class="section" aria-labelledby={`c-${c.id}`}>
            <h2 id={`c-${c.id}`}>
              <CategoryBadge id={c.id} name={c.data.name} bar />
              <span class="muted" style="font-weight: 400; font-size: var(--fs-s); margin-inline-start: 0.75em">
                {c.data.plain}
              </span>
            </h2>
            {LAYER_ORDER.map((layer) => {
              const sub = list.filter((t) => t.data.layer === layer);
              if (sub.length === 0) return null;
              return (
                <section class="layer-group">
                  <h3 class="layer-group__h">
                    <a href={`/layers/${layer}/`}>{LABELS.layer[layer]}</a>
                    <span class="muted">（{sub.length}件）</span>
                    <small class="muted">{LAYER_DESCRIPTIONS[layer]}</small>
                  </h3>
                  <div class="table-wrap">
                    <table class="table">
                      <thead>
                        <tr>
                          <th scope="col">ツール</th>
                          <th scope="col">一行で言うと</th>
                          <th scope="col">学習</th>
                          <th scope="col">料金</th>
                          <th scope="col">別名</th>
                        </tr>
                      </thead>
                      <tbody>
                        {sub.map((t) => (
                          <tr>
                            <th scope="row" class="nowrap">
                              <a href={`/tools/${t.id}/`}>{t.data.name}</a>
                            </th>
                            <td>{t.data.oneLiner}</td>
                            <td class="nowrap">{LABELS.learningCost[t.data.learningCost]}</td>
                            <td class="nowrap">{LABELS.costModel[t.data.cost.model]}</td>
                            <td class="muted">{t.data.aliases.join('、')}</td>
                          </tr>
                        ))}
                      </tbody>
                    </table>
                  </div>
                </section>
              );
            })}
            <p class="muted" style="font-size: var(--fs-s)">
              <a href={`/categories/${c.id}/`}>{c.data.name} の解説と比較表へ</a>
            </p>
          </section>
        );
      })
    }
  </div>
</Base>

<style>
  .layer-group + .layer-group {
    margin-block-start: 1rem;
  }
  .layer-group__h {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.25rem 0.6rem;
    margin-block-end: 0.4rem;
    font-size: var(--fs-m);
  }
  .layer-group__h small {
    font-weight: 400;
    flex-basis: 100%;
  }
</style>
