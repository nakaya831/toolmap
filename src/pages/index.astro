---
import Base from '@/layouts/Base.astro';
import CategoryBadge from '@/components/CategoryBadge.astro';
import { LABELS, SITE_DESCRIPTION, SITE_NAME } from '@/config';
import { byId, getAll, sortToolsForLearning, toolsInCategory, toolsInLayer } from '@/lib/content';

const { tools, categories, layers } = await getAll();
const toolsById = byId(tools);
---

<Base title={SITE_NAME} description={SITE_DESCRIPTION}>
  <div class="stack" style="--flow: 2.5rem">
    <header class="stack" style="--flow: 0.75rem">
      <h1>ソフトウェアは、どんな部品でできているか</h1>
      <p class="lede prose">
        プログラミングを学び始めると、「フロントエンド」「バックエンド」「データベース」「デプロイ」といった言葉が次々に出てくる。ここは、それらが<strong>それぞれ何をしていて、どうつながって一つのソフトウェアになるのか</strong>を、初学者向けに地図にしたサイトです。
      </p>
      <p class="prose">
        地図には2つの軸があります。部品の<strong>役割</strong>で分けた「分野」と、道具の<strong>性質</strong>で分けた「種別」。その上に代表的なツール {tools.length} 件を置き、どのツールも「できること」だけでなく「できないこと」と「限界値」を、公式ドキュメントの出典つきで同じ形で載せています。使い方は載せません。
      </p>
    </header>

    <div class="entrances">
      <section class="entrance" aria-labelledby="e1">
        <h2 id="e1"><a href="/categories/">① 分野から学ぶ</a></h2>
        <p class="muted">部品の「役割」で分ける。画面、サーバー、データの保存……という12の分野が、どうつながって一つのソフトウェアになるか。</p>
        <ol class="entrance__list">
          {
            categories.map((c) => (
              <li>
                <CategoryBadge id={c.id} name={c.data.name} />
                <span class="muted"> {c.data.plain}</span>
              </li>
            ))
          }
        </ol>
        <p><a href="/map/">全体像の図と、学ぶ順番へ</a></p>
      </section>
      <section class="entrance" aria-labelledby="e2">
        <h2 id="e2"><a href="/layers/">② 種別から学ぶ</a></h2>
        <p class="muted">道具の「性質」で分ける。自分で書く土台か、インストールして動かすものか、借りて使うサービスか。同じ分野の中で何を比べているのかが見える。</p>
        <ol class="entrance__list">
          {
            layers.map((l) => (
              <li>
                <a href={`/layers/${l.id}/`}>{l.data.name}</a>
                <span class="muted"> {l.data.plain}</span>
                <span class="muted">（{toolsInLayer(tools, l.id).length}件）</span>
              </li>
            ))
          }
        </ol>
        <p><a href="/layers/">種別同士の関係へ</a></p>
      </section>
    </div>

    <section class="section" aria-labelledby="all-h">
      <h2 id="all-h">ツール一覧（{tools.length}件）</h2>
      <p class="muted prose">
        分野ごとに、学習コストの低い順。各分野の「最初に触るなら」を太字にしている。
        <a href="/search/">検索</a>では略称（GAS、S3、PG）でも引ける。
      </p>
      <div class="cols" style="gap: 1.5rem 2rem">
        {
          categories.map((c) => {
            const list = sortToolsForLearning(toolsInCategory(tools, c.id));
            const startId = c.data.startWith.id;
            return (
              <section aria-labelledby={`all-${c.id}`}>
                <h3 id={`all-${c.id}`} style="border-bottom: 1px solid var(--rule); padding-block-end: 0.2rem">
                  <CategoryBadge id={c.id} name={c.data.name} />
                </h3>
                <ul class="toollist">
                  {list.map((t) => (
                    <li class:list={{ start: t.id === startId }}>
                      <a href={`/tools/${t.id}/`}>{t.data.name}</a>
                      <span class="tag" title="種別">{LABELS.layer[t.data.layer]}</span>
                      <span class="muted"> {t.data.oneLiner}</span>
                    </li>
                  ))}
                </ul>
              </section>
            );
          })
        }
      </div>
      <p style="margin-block-start: 1rem"><a href="/tools/">種別ごとに分けた全量の一覧へ</a></p>
    </section>
  </div>
</Base>

<style>
  .entrance__list {
    list-style: none;
    padding: 0;
    margin-block-start: 0.5rem;
    font-size: var(--fs-s);
  }
  .entrance__list li {
    padding-block: 0.2rem;
    max-width: none;
  }
  .entrance__list a {
    font-weight: 700;
  }
  .toollist {
    list-style: none;
    padding: 0;
    font-size: var(--fs-s);
  }
  .toollist li {
    max-width: none;
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .toollist a {
    font-weight: 400;
  }
  .toollist li.start a {
    font-weight: 700;
  }
  .toollist .tag {
    margin-inline-start: 0.4em;
  }
</style>
