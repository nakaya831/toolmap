---
import Base from '@/layouts/Base.astro';
import CategoryBadge from '@/components/CategoryBadge.astro';
import StackMap from '@/components/StackMap.astro';
import { LABELS, SITE_DESCRIPTION, SITE_NAME } from '@/config';
import { byId, getAll, sortToolsForLearning, toolsInCategory } from '@/lib/content';

const { tools, categories } = await getAll();
const toolsById = byId(tools);
---

<Base title={SITE_NAME} description={SITE_DESCRIPTION}>
  <div class="stack" style="--flow: 2.5rem">
    <header class="stack" style="--flow: 0.75rem">
      <h1>ソフトウェアは、どんな部品でできているか</h1>
      <p class="lede prose">
        プログラミングを学び始めると、「フロントエンド」「バックエンド」「データベース」「デプロイ」といった言葉が次々に出てくる。ここは、それらが<strong>それぞれ何をしていて、どうつながって一つのソフトウェアになるのか</strong>を、初学者向けに一枚の地図にしたサイトです。
      </p>
      <p class="prose">
        地図の上に、各分野の代表的なツール {tools.length} 件を置いています。どのツールも「できること」だけでなく「できないこと」と「限界値」を、公式ドキュメントの出典つきで同じ形で載せています。使い方は載せません。使い方は公式ドキュメントが最も正確だからです。
      </p>
    </header>

    <section class="section mt-0" aria-labelledby="map-h">
      <h2 id="map-h">全体像</h2>
      <StackMap categories={categories} />
      <p style="margin-block-start: 0.75rem">
        <a href="/map/">図の読み方と、学ぶ順番の解説へ</a>
      </p>
    </section>

    <section class="section" aria-labelledby="cat-h">
      <h2 id="cat-h">12の分野</h2>
      <p class="muted prose">上から順に学ぶことを想定した並び。各分野に「最初に触るなら」を1件ずつ挙げている。</p>
      <ol class="catlist">
        {
          categories.map((c) => {
            const start = toolsById.get(c.data.startWith.id);
            return (
              <li>
                <div class="catlist__head">
                  <CategoryBadge id={c.id} name={c.data.name} bar />
                  <span class="muted">{c.data.plain}</span>
                </div>
                <div class="catlist__body">
                  <span>{c.data.role}。</span>
                  {start && (
                    <span>
                      最初に触るなら <a href={`/tools/${start.id}/`}>{start.data.name}</a>。
                    </span>
                  )}
                </div>
              </li>
            );
          })
        }
      </ol>
    </section>

    <section class="section" aria-labelledby="all-h">
      <h2 id="all-h">ツール一覧（{tools.length}件）</h2>
      <p class="muted prose">
        分野ごとに、学習コストの低い順。名前を知っている道具から入ってもよい。
        <a href="/search/">検索</a>では略称（GAS、S3、PG）でも引ける。
      </p>
      <div class="cols" style="gap: 1.5rem 2rem">
        {
          categories.map((c) => {
            const list = sortToolsForLearning(toolsInCategory(tools, c.id));
            return (
              <section aria-labelledby={`all-${c.id}`}>
                <h3 id={`all-${c.id}`} style="border-bottom: 1px solid var(--rule); padding-block-end: 0.2rem">
                  <CategoryBadge id={c.id} name={c.data.name} />
                </h3>
                <ul class="toollist">
                  {list.map((t) => (
                    <li>
                      <a href={`/tools/${t.id}/`}>{t.data.name}</a>
                      <span class="muted"> {t.data.oneLiner}</span>
                      <span class="tag" title="学習コスト">{LABELS.learningCost[t.data.learningCost]}</span>
                    </li>
                  ))}
                </ul>
              </section>
            );
          })
        }
      </div>
    </section>
  </div>
</Base>

<style>
  .catlist {
    list-style: none;
    padding: 0;
    counter-reset: cat;
  }
  .catlist li {
    max-width: none;
    padding: 0.6rem 0;
    border-bottom: 1px solid var(--rule);
    display: grid;
    grid-template-columns: minmax(12rem, 18rem) 1fr;
    gap: 0.25rem 1.5rem;
    counter-increment: cat;
  }
  .catlist li:first-child {
    border-top: 2px solid var(--rule-strong);
  }
  .catlist__head {
    display: flex;
    flex-direction: column;
    gap: 0.15rem;
  }
  .catlist__head::before {
    content: counter(cat, decimal-leading-zero);
    font-family: var(--font-mono);
    font-size: var(--fs-s);
    color: var(--ink-2);
  }
  .catlist__head .muted {
    font-size: var(--fs-s);
  }
  .catlist__body {
    font-size: var(--fs-s);
    max-width: 44em;
  }
  @media (max-width: 40rem) {
    .catlist li {
      grid-template-columns: 1fr;
    }
  }
  .toollist {
    list-style: none;
    padding: 0;
    font-size: var(--fs-s);
  }
  .toollist li {
    max-width: none;
    padding: 0.3rem 0;
    border-bottom: 1px solid var(--rule);
  }
  .toollist a {
    font-weight: 700;
  }
  .toollist .tag {
    margin-inline-start: 0.4em;
  }
</style>
