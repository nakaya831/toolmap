---
import Base from '@/layouts/Base.astro';
import { LABELS } from '@/config';
import { byId, getAll, sortCandidates } from '@/lib/content';

const { scenarios, capabilities, tools } = await getAll();
const capsById = byId(capabilities);
const toolsById = byId(tools);
---

<Base title="課題から探す" description="「毎朝この集計をSlackに流したい」から手段へ。">
  <div class="stack" style="--flow: 1.5rem">
    <header class="stack" style="--flow: 0.5rem">
      <h1>課題から探す</h1>
      <p class="lede prose">
        課題を「必要な能力」に分解し、候補を比較する。単一の正解は示さない。各候補に「なぜ選ぶか／なぜ避けるか」を添える。
      </p>
    </header>
    <div class="table-wrap">
      <table class="table">
        <thead>
          <tr>
            <th scope="col">課題</th>
            <th scope="col">必要な能力</th>
            <th scope="col">候補</th>
          </tr>
        </thead>
        <tbody>
          {
            scenarios.map((s) => (
              <tr>
                <th scope="row">
                  <a href={`/scenarios/${s.id}/`}>{s.data.title}</a>
                </th>
                <td>
                  {s.data.needs.map((n, i) => (
                    <>
                      {i > 0 && '、'}
                      <a href={`/capabilities/${n.id}/`}>{capsById.get(n.id)?.data.name ?? n.id}</a>
                    </>
                  ))}
                </td>
                <td>
                  {sortCandidates(s.data.candidates).map((c, i) => (
                    <>
                      {i > 0 && '、'}
                      <span class={`fit fit--${c.fit}`}>
                        {toolsById.get(c.tool.id)?.data.name ?? c.tool.id}
                      </span>
                      <span class="muted">（{LABELS.fit[c.fit]}）</span>
                    </>
                  ))}
                </td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</Base>
